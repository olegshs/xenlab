# Build-time settings (Vite). Override them in .env.local, in the environment or as Docker build args.

# Where the source code is published. Shown as the "Source code" link; the AGPL requires
# public deployments of modified versions to point to their own source.
VITE_SOURCE_URL=https://github.com/olegshs/xenlab

# Public address of the site, e.g. https://xenlab.example.com. Used for og:url, the canonical
# link and absolute preview image URLs. Leave empty if unknown.
VITE_SITE_URL=
